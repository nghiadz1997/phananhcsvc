rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role 
        : 'GUEST';
    }

    function isSuperAdmin() {
      return getUserRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return getUserRole() == 'ADMIN' || isSuperAdmin();
    }

    function isManager() {
      return getUserRole() == 'MANAGER' || isAdmin();
    }

    function isStaff() {
      return getUserRole() == 'STAFF' || isManager();
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // 2. Reports collection (Public submission & tracking)
    match /reports/{reportId} {
      // Cho phép đọc công khai (để tra cứu theo mã PYC-) hoặc khi đã đăng nhập
      allow read: if true;
      // Cho phép gửi phản ánh mới (public hoặc user)
      allow create: if request.resource.data.title != null 
                    && request.resource.data.code != null;
      // Trưởng phòng & Admin được cập nhật mọi thứ; Staff cập nhật tiến độ; Người gửi đánh giá sau hoàn thành
      allow update: if isManager()
                    || (isStaff() && resource.data.assignedTo == request.auth.uid)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'feedback', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // 3. Tasks collection (Công việc nội bộ do Manager giao)
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow create: if isManager();
      allow update: if isManager()
                    || (isStaff() && resource.data.assignedTo == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 4. Comments collection (Trao đổi xử lý)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.authorName != null;
      allow update: if false; // Không sửa bình luận để bảo toàn lịch sử
      allow delete: if isAdmin();
    }

    // 5. Activity logs (Audit Trail bất biến)
    match /activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if true; // Hệ thống tự động ghi log mọi thao tác
      allow update: if false; // TUYỆT ĐỐI KHÔNG SỬA LOG
      allow delete: if false; // TUYỆT ĐỐI KHÔNG XÓA LOG
    }

    // 6. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        (resource.data.recipientRole == getUserRole()) ||
        isAdmin()
      );
      allow create: if true;
      allow update: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 7. Departments, Categories, Locations, Settings
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
